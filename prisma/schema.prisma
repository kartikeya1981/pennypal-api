generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  kids         Kid[]
}

/// A child profile managed by a parent. Amounts are whole Kid Coins.
model Kid {
  id             String   @id @default(cuid())
  parentId       String
  parent         User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name           String
  avatar         String   @default("🦊")
  birthYear      Int
  monthlyEarning Int      @default(0)
  /// Day of the month (1-31) the monthly earning is credited; short months use their last day.
  earningDay     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([parentId])
}
